---
import Base from '../layouts/Base.astro';
export const prerender = true;
---
<Base titulo="Proyectos" activo="proyectos">
  <h1>🚀 Proyectos</h1>
  <p class="sub">Los proyectos usan el backend cuando existe y almacenamiento local cuando no.</p>
  <div class="card" style="margin-bottom:1rem">
    <h3>➕ Nuevo proyecto</h3>
    <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.5rem">
      <input id="pn" class="buscar" style="flex:1;min-width:220px;margin:0" placeholder="Nombre del proyecto">
      <select id="pl" class="buscar" style="width:auto;margin:0;padding:.65rem .8rem"><option value="">Sin lenguaje</option><option>TypeScript</option><option>Python</option><option>JavaScript</option><option>React</option><option>C#</option><option>Java</option><option>Go</option><option>Rust</option></select>
      <button class="btn" id="crear">Crear proyecto</button>
    </div>
    <p id="msg" style="color:var(--muted);font-size:.85rem;margin-top:.5rem"></p>
  </div>
  <div id="estado" class="card" style="margin-bottom:1rem"></div>
  <div id="lista"><p style="color:var(--muted)">Cargando proyectos…</p></div>
  <script is:inline>
    const $=s=>document.querySelector(s);
    async function cargar(){
      await PT.ready();
      const d=await PT.listProjects();
      $('#estado').innerHTML=d.local?'🏠 <b>Modo local</b> · almacenamiento persistente en este navegador/runtime.':'☁️ <b>Modo cloud</b> · proyectos sincronizados.';
      const ps=d.projects||[];
      $('#lista').innerHTML=ps.length?'<div class="grid">'+ps.map(p=>'<div class="card"><h3>🧩 '+PT.esc(p.name)+'</h3><p style="color:var(--muted);font-size:.82rem">'+PT.esc(p.metadata?.language||'proyecto')+' · '+PT.esc(String(p.created||'').slice(0,10))+'</p>'+(p.path?'<p style="font-size:.75rem;word-break:break-all;color:var(--muted)">'+PT.esc(p.path)+'</p>':'')+'<button class="btn ghost del" data-id="'+PT.esc(p.id)+'">🗑 Eliminar</button></div>').join('')+'</div>':'<div class="card"><h3>🧩 Todavía no hay proyectos</h3><p style="color:var(--muted)">Creá el primero arriba.</p></div>';
      document.querySelectorAll('.del').forEach(b=>b.onclick=async()=>{if(!confirm('¿Eliminar este proyecto?'))return;const r=await PT.deleteProject(b.dataset.id);if(r.ok)cargar();});
    }
    $('#crear').onclick=async()=>{const n=$('#pn').value.trim()||'Proyecto';$('#msg').textContent='⏳ creando…';const r=await PT.createProject(n,$('#pl').value);$('#msg').textContent=r.ok?(r.local?'🏠 creado localmente':'☁️ creado en cloud'):'⚠ '+(r.error||'falló');if(r.ok){$('#pn').value='';cargar();}};
    cargar();
  </script>
</Base>
