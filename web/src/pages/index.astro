---
import Base from '../layouts/Base.astro';
import { readFileSync } from 'node:fs';
export const prerender = true;
const B = import.meta.env.BASE_URL.replace(/\/$/, ''); // '' en raíz, sin '//' roto
// 🧾 JSON-LD: catálogo de cursos para buscadores (SEO enriquecido)
const indice = JSON.parse(readFileSync(new URL('../../public/data/indice.json', import.meta.url), 'utf-8'));
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Plataforma Total — 57 cursos tech en español',
  itemListElement: indice.map((c, i) => ({
    '@type': 'ListItem', position: i + 1,
    item: {
      '@type': 'Course', name: c.n,
      url: `https://plataforma-total-web.pages.dev/curso/${i + 1}`,
      provider: { '@type': 'Organization', name: 'Plataforma Total', sameAs: 'https://plataforma-total-web.pages.dev' },
      isAccessibleForFree: !!c.free,
      hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', courseWorkload: 'PT25M' },
    },
  })),
};
---
<Base titulo="Inicio" activo="inicio">
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  <h1 id="saludo">👋 ¡Hola!</h1>
  <p class="sub">Tu escuela de programación en español — web, móvil y escritorio, con el mismo progreso sincronizado.</p>

  <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">
    <div class="card"><h3>🔥 Racha</h3><p style="font-size:1.8rem;font-weight:800" id="racha">0 días</p><p style="color:var(--muted);font-size:.85rem">25 min al día mínimo</p></div>
    <div class="card"><h3>⭐ Nivel <span id="nivel">1</span></h3><div class="barra"><div id="xpbar" style="width:0%"></div></div><p style="color:var(--muted);font-size:.85rem;margin-top:.4rem"><span id="xpnum">0</span> XP</p></div>
    <div class="card"><h3>📚 Lecciones</h3><p style="font-size:1.8rem;font-weight:800" id="leidas">0</p><p style="color:var(--muted);font-size:.85rem">de 329</p></div>
    <div class="card"><h3>🧠 Quizzes</h3><p style="font-size:1.8rem;font-weight:800" id="quiz">0/0</p><p style="color:var(--muted);font-size:.85rem">aciertos</p></div>
  </div>

  <div id="continuar" class="card clickable" style="margin-top:1rem;border-left:4px solid var(--acc)" hidden></div>

  <h2>🗺️ ¿Qué hacemos hoy?</h2>
  <div class="grid">
    <div class="card clickable" onclick={`location.href='${B}/aprender/'`}><h3>📚 Aprender</h3><p>57 cursos: los 17 de fundamentos gratis completos (¡matemáticas y lógica incluidas!), con quizzes interactivos.</p></div>
    <div class="card clickable" onclick={`location.href='${B}/chat/'`}><h3>🤖 IA Chat</h3><p>Tu tutor estilo ChatGPT: dudas, código y explicaciones — con contexto de tu lección.</p></div>
    <div class="card clickable" onclick={`location.href='${B}/pomo/'`}><h3>🔥 Pomodoro</h3><p>25 minutos de foco, 5 de descanso. La racha se alimenta sola.</p></div>
    <div class="card clickable" onclick={`location.href='${B}/certificados/'`}><h3>📜 Certificados</h3><p>Terminá un curso y descargá tu certificado con código verificable.</p></div>
  </div>

  <p style="margin-top:1.2rem;color:var(--muted);font-size:.85rem">🪟 ¿Querés la experiencia completa offline? <a href="https://github.com/SoftEngAi-dev/plataforma-total-pro/releases/latest/download/PlataformaTotal-Windows.exe">Descargá el .exe de Windows</a> — y en tu celular, «Añadir a pantalla principal».</p>

  <script is:inline>
    PT.cargar();
    const s = PT.s, n = PT.xpNivel();
    if (s.alias) document.getElementById('saludo').innerHTML = '👋 ¡Hola, <b>' + PT.esc(s.alias) + '</b>!';
    document.getElementById('racha').textContent = s.racha.n + ' día' + (s.racha.n === 1 ? '' : 's');
    document.getElementById('nivel').textContent = PT.nivel();
    document.getElementById('xpbar').style.width = n.pct + '%';
    document.getElementById('xpnum').textContent = s.xp;
    const tot = Object.values(s.leidas).reduce((a, l) => a + l.length, 0);
    document.getElementById('leidas').textContent = tot;
    document.getElementById('quiz').textContent = s.quiz_ok + '/' + s.quiz_tot;
    if (s.ultima) {
      const d = document.getElementById('continuar');
      d.hidden = false;
      d.innerHTML = '<h3>▶️ Continuar donde lo dejaste</h3><p>' + PT.esc(s.ultima.t || '') + '</p><p style="color:var(--muted);font-size:.85rem">Curso ' + (s.ultima.c + 1) + ' · lección ' + (s.ultima.j + 1) + '</p>';
      d.onclick = () => location.href = '../aprender/#/c/' + s.ultima.c + '/' + s.ultima.j;
    }
  </script>
</Base>
