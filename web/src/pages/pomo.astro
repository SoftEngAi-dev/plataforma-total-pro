---
import Base from '../layouts/Base.astro';
export const prerender = true;
---
<Base titulo="Pomodoro" activo="pomo">
  <div class="pomo card" style="max-width:520px;margin:2rem auto">
    <h1>🔥 Pomodoro</h1>
    <p class="modo" id="modo">Sesión de foco — 25 minutos</p>
    <div class="reloj" id="reloj">25:00</div>
    <div style="display:flex;gap:.5rem;justify-content:center;margin:1rem 0">
      <button class="btn" id="start">▶ Empezar</button>
      <button class="btn ghost" id="pausa">⏸ Pausa</button>
      <button class="btn ghost" id="reset">↺</button>
    </div>
    <p style="color:var(--muted);font-size:.9rem">Completados hoy: <b id="hechos">0</b> 🍅 · cada uno suma +15 XP y alimenta tu racha</p>
    <p style="color:var(--muted);font-size:.8rem;margin-top:.6rem">Tip: poné la lección al lado, 25 min de foco real &gt; 2 h distraído.</p>
  </div>
  <script is:inline>
    PT.cargar();
    let modo = 'foco', t = 25 * 60, timer = null;
    const $ = s => document.querySelector(s);
    const hechos = +(localStorage.getItem('pt_pomo_' + PT.hoy()) || 0);
    $('#hechos').textContent = hechos;
    const pintar = () => {
      const m = Math.floor(t / 60), s = t % 60;
      $('#reloj').textContent = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
      document.title = `⏱ ${$('#reloj').textContent} — ${modo === 'foco' ? 'FOCO' : 'descanso'}`;
      $('#modo').textContent = modo === 'foco' ? 'Sesión de foco — 25 minutos' : 'Descanso — 5 minutos ☕';
    };
    const tick = () => {
      if (--t <= 0) {
        clearInterval(timer); timer = null;
        if (modo === 'foco') {
          const h = +(localStorage.getItem('pt_pomo_' + PT.hoy()) || 0) + 1;
          localStorage.setItem('pt_pomo_' + PT.hoy(), h);
          $('#hechos').textContent = h;
          PT.actividad(15);
          modo = 'descanso'; t = 5 * 60;
          try { new AudioContext(); navigator.vibrate && navigator.vibrate([200, 100, 200]); } catch (e) {}
        } else { modo = 'foco'; t = 25 * 60; }
      }
      pintar();
    };
    $('#start').onclick = () => { if (!timer) timer = setInterval(tick, 1000); };
    $('#pausa').onclick = () => { clearInterval(timer); timer = null; };
    $('#reset').onclick = () => { clearInterval(timer); timer = null; modo = 'foco'; t = 25 * 60; pintar(); };
    pintar();
  </script>
</Base>
