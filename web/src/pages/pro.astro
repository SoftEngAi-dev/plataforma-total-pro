---
import Base from '../layouts/Base.astro';
export const prerender = true;
---
<Base titulo="PRO" activo="pro">
  <h1>💎 Plataforma Total PRO</h1>
  <p class="sub">La web te regala los 15 cursos de fundamentos completos. PRO desbloquea los 32 avanzados (+ todos los futuros) en la app de escritorio.</p>
  <div id="estado" class="card" style="border-left:4px solid var(--acc2);margin-bottom:1rem"></div>
  <div class="grid" id="planes" style="grid-template-columns:repeat(auto-fit,minmax(210px,1fr))"></div>
  <h2>✔ Qué incluye PRO</h2>
  <div class="card">
    <p>✔ Los 32 cursos PRO y TODOS los que vengan (Astro, Next.js, Rust, Go, IA, Seguridad…)<br>
    ✔ App de escritorio completa: IA local opcional, 3.941 materiales descargables, certificados verificables<br>
    ✔ Auto-actualización con 1 clic — cada mejora te llega sola<br>
    ✔ 100% offline tras activar tu clave (se valida online una sola vez)<br>
    ✔ Pago seguro vía Lemon Squeezy · reembolso 14 días · 🎓 estudiantes −40%</p>
  </div>
  <h2>🔑 Cómo se activa</h2>
  <div class="card"><p>1️⃣ Comprás tu plan → 2️⃣ te llega la clave por email (~1 min) → 3️⃣ en la app de escritorio tocás <b>💎 Ser PRO</b> y la pegás. ¡Listo!</p></div>
  <script is:inline>
    const FALL = { precios: { mensual_usd: 7.99, anual_usd: 79, lifetime_usd: 169 },
      checkout_mensual: '../../#precios', checkout_anual: '../../#precios', checkout_lifetime: '../../#precios' };
    fetch('https://raw.githubusercontent.com/SoftEngAi-dev/plataforma-total-pro/main/monetizacion.json')
      .then(r => r.json()).catch(() => FALL).then(cfg => {
        const p = cfg.precios || FALL.precios;
        document.getElementById('planes').innerHTML = `
          <div class="card"><h3>🗓️ Mensual</h3><p style="font-size:1.6rem;font-weight:800">U$S ${p.mensual_usd}<span style="font-size:.85rem;color:var(--muted)">/mes</span></p><p style="color:var(--muted);font-size:.85rem">Prueba de baja fricción, cancelás cuando quieras</p><a class="btn big" href="${cfg.checkout_mensual || FALL.checkout_mensual}">Empezar</a></div>
          <div class="card" style="border-color:var(--acc)"><h3>⭐ Anual</h3><p style="font-size:1.6rem;font-weight:800">U$S ${p.anual_usd}<span style="font-size:.85rem;color:var(--muted)">/año</span></p><p style="color:var(--muted);font-size:.85rem">2 meses gratis vs mensual — el favorito</p><a class="btn big" href="${cfg.checkout_anual || FALL.checkout_anual}">Elegir anual</a></div>
          <div class="card"><h3>♾️ De por vida</h3><p style="font-size:1.6rem;font-weight:800">U$S ${p.lifetime_usd}</p><p style="color:var(--muted);font-size:.85rem">Un solo pago, todo futuro incluido</p><a class="btn big" href="${cfg.checkout_lifetime || FALL.checkout_lifetime}">Ser Fundador</a></div>`;
      });
    PT.cargar();
    document.getElementById('estado').innerHTML = PT.s.alias
      ? `<h3>👤 ${PT.esc(PT.s.alias)}</h3><p style="color:var(--muted)">Tu progreso viaja con tu sesión. La clave 💎 PRO se activa en la app de escritorio (un solo clic).</p>`
      : `<h3>🆓 Estás en modo local</h3><p style="color:var(--muted)">Creá tu sesión en el sidebar para sincronizar el progreso entre dispositivos (gratis).</p>`;
  </script>
</Base>
