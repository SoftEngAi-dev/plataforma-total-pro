---
import Base from '../layouts/Base.astro';
export const prerender = true;
---
<Base titulo="PRO" activo="pro">
  <h1>💎 Plataforma Total PRO</h1>
  <p class="sub">La web te regala los 17 cursos de fundamentos completos. PRO desbloquea los 40 avanzados — IA aplicada, Cloudflare/edge, HTMX, WASM, datos moderna, observabilidad, Tauri… (+ todos los futuros) en la app de escritorio.</p>
  <div id="estado" class="card" style="border-left:4px solid var(--acc2);margin-bottom:1rem"></div>
  <div class="grid" id="planes" style="grid-template-columns:repeat(auto-fit,minmax(210px,1fr))"></div>
  <h2>✔ Qué incluye PRO</h2>
  <div class="card">
    <p>✔ Los 40 cursos PRO y TODOS los que vengan (Astro, Next.js, Rust, Go, IA, Seguridad…)<br>
    ✔ App de escritorio completa: IA local opcional, 3.941 materiales descargables, certificados verificables<br>
    ✔ Auto-actualización con 1 clic — cada mejora te llega sola<br>
    ✔ 100% offline tras activar tu clave (se valida online una sola vez)<br>
    ✔ Pago seguro vía Lemon Squeezy · reembolso 14 días · 🎓 estudiantes −40%</p>
  </div>
  <h2>🔑 Cómo se activa</h2>
  <div class="card">
    <p>1️⃣ Comprás tu plan con tu email → 2️⃣ el servidor recibe el pago al instante (webhook verificado con firma HMAC) → 3️⃣ activás:</p>
    <p style="margin-top:.4rem">🌐 <b>En la web:</b> con tu sesión iniciada, escribí el <b>email exacto de la compra</b> acá abajo y tocá <b>Activar</b> — queda PRO en todos tus dispositivos.<br>
    💻 <b>En la app de escritorio:</b> te llega la clave por email y la pegás en <b>💎 Ser PRO</b> (un solo clic, después funciona 100% offline).</p>
  </div>
  <div class="card" id="activador">
    <h3>⚡ Activación web (instantánea)</h3>
    <div id="act-form" style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.5rem">
      <input id="act-email" type="email" placeholder="tu-email-de-compra@ejemplo.com" style="flex:1;min-width:200px;padding:.7rem .9rem;border-radius:10px;border:1px solid var(--borde);background:var(--bg);color:var(--tx)" />
      <button class="btn big" id="act-btn">⚡ Activar PRO</button>
    </div>
    <p id="act-msg" style="margin-top:.6rem;font-size:.9rem"></p>
  </div>
  <script is:inline>
    const FALL = { precios: { mensual_usd: 7.99, anual_usd: 79, lifetime_usd: 169 },
      checkout_mensual: '../../#precios', checkout_anual: '../../#precios', checkout_lifetime: '../../#precios' };
    fetch('https://raw.githubusercontent.com/SoftEngAi-dev/plataforma-total-pro/main/monetizacion.json')
      .then(r => r.json()).catch(() => FALL).then(cfg => {
        const p = cfg.precios || FALL.precios;
        PT.cargar();
        const aliasQ = PT.s.alias ? (u => u + (u.includes('?') ? '&' : '?') + 'checkout[custom][alias]=' + encodeURIComponent(PT.s.alias)) : (u => u);
        document.getElementById('planes').innerHTML = `
          <div class="card"><h3>🗓️ Mensual</h3><p style="font-size:1.6rem;font-weight:800">U$S ${p.mensual_usd}<span style="font-size:.85rem;color:var(--muted)">/mes</span></p><p style="color:var(--muted);font-size:.85rem">Prueba de baja fricción, cancelás cuando quieras</p><a class="btn big" href="${aliasQ(cfg.checkout_mensual || FALL.checkout_mensual)}">Empezar</a></div>
          <div class="card" style="border-color:var(--acc)"><h3>⭐ Anual</h3><p style="font-size:1.6rem;font-weight:800">U$S ${p.anual_usd}<span style="font-size:.85rem;color:var(--muted)">/año</span></p><p style="color:var(--muted);font-size:.85rem">2 meses gratis vs mensual — el favorito</p><a class="btn big" href="${aliasQ(cfg.checkout_anual || FALL.checkout_anual)}">Elegir anual</a></div>
          <div class="card"><h3>♾️ De por vida</h3><p style="font-size:1.6rem;font-weight:800">U$S ${p.lifetime_usd}</p><p style="color:var(--muted);font-size:.85rem">Un solo pago, todo futuro incluido</p><a class="btn big" href="${aliasQ(cfg.checkout_lifetime || FALL.checkout_lifetime)}">Ser Fundador</a></div>`;
      });
    PT.cargar();
    function pintarEstado() {
      document.getElementById('estado').innerHTML = PT.s.pro
        ? `<h3>💎 ¡PRO ACTIVO!</h3><p style="color:var(--muted)">Gracias por apoyar el proyecto 🙌 Tu cuenta <b>${PT.esc(PT.s.alias || '')}</b> tiene todo desbloqueado.</p>`
        : PT.s.alias
          ? `<h3>👤 ${PT.esc(PT.s.alias)}</h3><p style="color:var(--muted)">Sesión con nube activa. ¿Ya compraste? Activá abajo con el email de compra ⚡</p>`
          : `<h3>🆓 Estás en modo local</h3><p style="color:var(--muted)">Creá tu sesión en el sidebar para activar PRO y sincronizar entre dispositivos.</p>`;
      document.getElementById('act-form').style.display = (PT.s.alias && !PT.s.pro) ? 'flex' : 'none';
    }
    pintarEstado();
    if (PT.s.token) PT.proSinc().then(pintarEstado);  // auto-detectar compra al entrar (checkout con alias passthrough)
    document.getElementById('act-btn').onclick = () => {
      const msg = document.getElementById('act-msg');
      msg.style.color = 'var(--muted)'; msg.textContent = '⏳ Verificando con el servidor…';
      PT.proActivar(document.getElementById('act-email').value).then(d => {
        if (d.ok && d.pro) {
          msg.style.color = 'var(--verde, #3fb950)'; msg.textContent = '💎 ¡PRO ACTIVADO! Gracias por apoyar el proyecto 🎉';
          pintarEstado();
        } else {
          msg.style.color = 'var(--rojo, #f85149)'; msg.textContent = '⚠️ ' + (d.error || 'No se pudo activar');
        }
      });
    };
  </script>
</Base>
